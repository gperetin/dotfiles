font-family = Hack Nerd Font Mono
font-size = 12

# Bundled Ghostty theme; it provides foreground, background, and ANSI colors.
theme = Catppuccin Mocha

cursor-style = block
cursor-style-blink = false
# Keep Ghostty shell integration, but do not let it switch the prompt cursor to a bar.
shell-integration-features = no-cursor
mouse-hide-while-typing = false
scrollback-limit = 10000000
# Copy to both PRIMARY (used by middle-click paste) and CLIPBOARD.
copy-on-select = clipboard
window-decoration = true
window-width = 80
window-height = 24
window-padding-x = 5
window-padding-y = 5

# Retain Alacritty's custom Ctrl-S binding (send Ctrl-Z).
keybind = ctrl+s=text:\x1a
